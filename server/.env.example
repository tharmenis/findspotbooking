# Port the Express server listens on
PORT=3000

# Public base URL of the booking engine (for logs / redirects if ever needed)
PUBLIC_BASE_URL=https://book.findspot.net

# Base URL of the WordPress site the custom REST endpoints live on
WP_BASE_URL=https://findspot.net

# Set to true to serve in-memory mock availability/reservations instead of
# calling WordPress (for local dev before the WP plugin exists)
WP_MOCK_MODE=true

# Shared secret WordPress sends as X-Sync-Secret on /internal/listings/sync
SYNC_SECRET=change-me

# Connection string for the local MySQL database (physically separate from WordPress's)
DATABASE_URL="mysql://user:password@localhost:3306/findspot_booking"

# TTLs (seconds)
EMBED_ASSET_TTL=300
BUNDLE_ASSET_TTL=31536000

# Request body size limit for JSON (bytes)
MAX_BODY_BYTES=16384
