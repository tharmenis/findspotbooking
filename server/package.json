{
  "name": "@findspot/server",
  "private": true,
  "version": "0.1.0",
  "description": "Express BFF for the findspot standalone booking widget",
  "main": "src/server.js",
  "type": "module",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=1 --test-reporter=spec \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "@prisma/client": "^6.3.1"
  },
  "devDependencies": {
    "prisma": "^6.3.1",
    "supertest": "^7.0.0"
  }
}
